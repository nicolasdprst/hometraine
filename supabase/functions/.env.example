# À enregistrer avec `supabase secrets set --env-file supabase/functions/.env`
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/VOTRE_DEPLOIEMENT/exec
GOOGLE_SCRIPT_SECRET=remplacer-par-un-secret-long-et-aleatoire
EMAIL_WORKER_SECRET=remplacer-par-un-secret-long-et-aleatoire
GEMINI_API_KEY=remplacer-par-la-cle-google-ai-studio
# Facultatif : ce modèle est aussi utilisé par défaut dans la fonction.
GEMINI_MODEL=gemini-2.5-flash

# Fournies automatiquement par Supabase en production :
# SUPABASE_URL=
# SUPABASE_ANON_KEY= (ou SUPABASE_PUBLISHABLE_KEY)
# SUPABASE_SERVICE_ROLE_KEY= (ou SUPABASE_SECRET_KEY)
